# ══════════════════════════════════════════════════════════════════════
#  بوّابةُ التجهيز — منفصلةٌ عن بوّابة الإنتاج
# ══════════════════════════════════════════════════════════════════════
#
# **ولا نطاقَ إنتاجٍ في هذا الملفّ** — **ولو أُدخل لَرفضه
# `TestStagingConfigNeverNamesProduction`.**
#
# # وحالان
#
# **قبل النطاق**: يُخدَم على IP أو `localhost:8080` بلا `TLS` —
# **ويُسجَّل `DNS/TLS PENDING`** (البند ١٤).
#
# **بعد النطاق**: يُبدَّل `:80` بـ`staging.rahalgo.com` **فتتولّى Caddy
# الشهادةَ بنفسها**، **ولا اعتمادَ يُرسَل على `HTTP` مكشوف** (البند ١٥).

:80 {
	# ══════════════════════════════════════════════════════════════
	# **سجلُّ الوصول — والرمزُ لا يُكتب** (دورة ٦٩أ)
	# ══════════════════════════════════════════════════════════════
	#
	# **وCaddy لا تكتب سطرَ وصولٍ ما لم يُطلب** — فبلا هذه الكتلة لا
	# تُعرف حالةُ ردٍّ ولا مدّةُ طلب. **وقِيس ٢٠٢٦-٠٩-١١: عشرةُ طلباتٍ
	# ⇒ صفرُ أسطر.** (دورةُ ٦٧ب أبلغت «غيرُ مقيسة».)
	#
	# # والخطرُ الأوّل: رمزُ الدخول في الاستعلام
	#
	# **قناةُ البثّ تُنادى `/api/v1/ws?token=eyJ…`**
	# (`server/ws.go` يقرأ `Query().Get("token")`) — **وCaddy تسجّل
	# `uri` كاملاً بالاستعلام.** **فسجلٌّ بلا مُرشِّحٍ يكتب رمزَ وصولٍ
	# صالحاً في كلّ اتّصال.** وقِيس: ظهر الرمزُ حرفيّاً بلا المُرشِّح،
	# **واختفى به** — وهو شاهدُ الدورة السالب.
	#
	# # والترويساتُ تُحذف جملةً
	#
	# **وCaddy تُخفي `Authorization` و`Cookie` من نفسها** (قِيس:
	# `"REDACTED"`) — **لكنّها تُرشِّح بالمنع لا بالسماح**، فلا قائمةَ
	# سماحٍ للترويسات. **ومن أراد ألّا يُسرّب ما لم يخطر له حذف الخريطة
	# كلَّها** — وهو ما فُعل، للطلب وللردّ.
	#
	# # والإحداثيّةُ الدقيقةُ تُخفى ولا تُحذف
	#
	# **الحذفُ يمحو أثرَ وجودِ المعامل** — **والإخفاءُ يُبقي «سُئل عن
	# موقعٍ» ويمحو «أين».** والأوّلُ للرمز، والثاني لما عداه.
	#
	# # وعنوانُ المصدر يُقنَّع
	#
	# **الربعُ الأخيرُ يُصفَّر** — يكفي لتمييز شبكةٍ تُسيء، **ولا يكفي
	# لتعقّب إنسان.**
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					replace lat REDACTED
					replace lng REDACTED
					replace q REDACTED
					replace bbox REDACTED
					replace ref REDACTED
				}
				request>headers delete
				resp_headers delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 32
				}
			}
		}
	}

	# **وزمنُ المنبع غيرُ زمن البوّابة** — **و`duration` يجمعهما**،
	# فمن رآه وحدَه لا يعرف أفي المحرّك بطءٌ أم في الطريق. **وحالةُ
	# المنبع لا عنصرَ نائبَ لها** في Caddy، فلا تُلتقَط.
	log_append upstream_duration {http.reverse_proxy.upstream.duration_ms}

	# **ورايةٌ في كلّ ردّ** (البند ٤٥) — **يقرؤها المتصفّحُ والأداةُ
	# والإنسان.** **ومن جرّب على «التجهيز» وهو الإنتاج لا يعرف إلّا
	# بعلامةٍ في الطريق نفسِه.**
	header {
		X-RahalGo-Environment "staging"
		-Server
	}

	# ── الصحّة ─────────────────────────────────────────────────────
	#
	# **وبابُ الصحّة في جذر المحرّك لا تحت `/api`** — **فبلا هذا السطر
	# يذهب إلى الويب فيردّ لا شيئاً**، **ومراقبةٌ تسأل بابَ صحّةٍ لا
	# يصل إلى المحرّك تقول «سليم» عن خادمٍ ميّت.**
	#
	# (قِيس على `CX33` ٢٠٢٦-٠٩-٠٦: `curl :8080/healthz` ردَّ `000`
	#  والمحرّكُ يردّ `ok` من داخل حاويته.)
	handle /healthz {
		reverse_proxy api:8080
	}

	# ── المحرّك ────────────────────────────────────────────────────
	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# **وقناةُ البثّ ترقيةٌ** — تمرّ بالمسار نفسِه.
	handle /api/v1/ws {
		reverse_proxy api:8080
	}

	# ── الوسائط ────────────────────────────────────────────────────
	#
	# **ومجلَّدُ تجهيزٍ خاصٌّ به** (البند ٩) — **حجمٌ اسمُه
	# `rahalgo-staging_uploads`**، ولا يشترك مع الإنتاج في بايت.
	handle /media/* {
		reverse_proxy api:8080
	}

	# ── الويب ──────────────────────────────────────────────────────
	handle {
		reverse_proxy web:3000
	}
}
