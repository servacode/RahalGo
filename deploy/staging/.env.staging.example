# ══════════════════════════════════════════════════════════════════════
#  بيئةُ التجهيز — قالبٌ يُنسَخ إلى `.env.staging` ويُملأ على الخادم
# ══════════════════════════════════════════════════════════════════════
#
# **ولا سرَّ حقيقيٌّ في هذا الملفّ** — **وهو المتتبَّعُ في git، و`.env.staging`
# ليس** (انظر `.gitignore`).
#
# # ولا يُنسَخ سرٌّ من الإنتاج (البند ٢)
#
# **كلمةُ قاعدةٍ وسرُّ توقيعٍ وكلمةُ أدمن — كلُّها خاصّةٌ بالتجهيز.**
#
# **وسرُّ التوقيعِ خصوصاً**: **لو نُسخ من الإنتاج لَقبِل خادمُ الإنتاج
# رموزَ التجهيز** — **فيصير حسابُ تجربةٍ حسابَ إنتاجٍ بضغطة.**
#
# **يُولَّد كلٌّ منها هكذا:**
#
#     openssl rand -base64 36
#
# # ولا يُشتقُّ سرٌّ من اسمٍ يُخمَّن
#
# **`staging-secret` و`rahalgo-staging` ليست أسراراً** — **والتجهيزُ
# مكشوفٌ على الإنترنت إن نُشر، وحسابُ أدمنٍ فيه يفتح قاعدةً كاملة.**

# ── القاعدة ───────────────────────────────────────────────────────────
STAGING_DB_PASSWORD=

# ── التوقيع ───────────────────────────────────────────────────────────
STAGING_JWT_SECRET=

# ── أوّلُ أدمن ────────────────────────────────────────────────────────
#
# **وهاتفٌ اصطناعيٌّ لا هاتفُ إنسان** (البند ١٦) — **ورقمُ تجربةٍ يصل
# إلى صاحبه رسائلُ نظامٍ لا يعرفها.**
#
# **والمزوّدُ `dev` فلا رسالةَ تُرسَل أصلاً** — والرمزُ يُطبع في السجلّ.
STAGING_ADMIN_PHONE=0900000001
STAGING_ADMIN_PASSWORD=

# ── هويّةُ البناء (البند ١٠) ──────────────────────────────────────────
#
# **يملؤهما `deploy.sh` من git** — **ولا تُكتبان بيد.**
SOURCE_COMMIT=
BUILD_ID=

# ── العناوين ──────────────────────────────────────────────────────────
#
# **قبل النطاق**: `http://<IP>:8080`.
# **بعده**: `https://staging.rahalgo.com`.
#
# **ولا يُكتب هنا نطاقُ إنتاجٍ أبداً** — **ويُسقط الحارسُ من كتبه.**
STAGING_API_URL=http://localhost:8080
STAGING_SITE_URL=http://localhost:8080

# ── الخرائط والمسارات (البند ٢٣) ─────────────────────────────────────
#
# **ونمطُ الخريطة يُقرأ قراءةً محضة** — **فيُشارَك مع الإنتاج بلا ضرر**
# (`maps.rahalgo.com` ملفّاتٌ ساكنةٌ للقراءة).
#
# **وOSRM يُقرأ أيضاً ولا يُكتب فيه** — **فيُترَك فارغاً حتّى يُحتاج**،
# **ونسخُ بنية المسارات بلا حاجةٍ يأكل ذاكرةَ خادمٍ صغير.**
STAGING_MAP_STYLE_URL=
STAGING_OSRM_URL=
STAGING_GEOCODER_URL=
