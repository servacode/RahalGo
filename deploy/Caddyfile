# ══════════════════════════════════════════════════════════════════════
#  البوّابة — شهادةٌ تُجدَّد وحدَها، ونطاقان لا خادمان
# ══════════════════════════════════════════════════════════════════════
#
# **وCaddy تطلب الشهادةَ من Let's Encrypt وتُجدّدها قبل انتهائها** — بلا
# `certbot` ولا مهمّةٍ دوريّةٍ تُنسى. **وشهادةٌ تنتهي ليلَ الجمعة تُغلق
# المنصّةَ حتّى يستيقظ أحد.**
#
# **والنطاقان يقصدان حاويتين**: `rahalgo.com` الويبَ و`api.rahalgo.com`
# المحرّك. **ولا منفذَ مكشوفٌ غيرُهما** — القاعدةُ والذاكرةُ وOSRM في
# شبكةٍ داخليّةٍ لا تُنادى من خارج.

{
	# **بريدُ إشعار انتهاء الشهادة** — يُرسل قبلها بأسبوعين.
	email servacode@gmail.com
}

# ══════════════════════════════════════════════════════════════════════
# **سجلُّ الوصول — قصاصةٌ واحدةٌ لثلاثة نطاقات** (دورة ٦٩ب)
# ══════════════════════════════════════════════════════════════════════
#
# **وCaddy لا تكتب سطرَ وصولٍ ما لم يُطلب** — **فبلا هذه الكتلة لا
# تُعرف حالةُ ردٍّ ولا مدّةُ طلب.** (دورةُ ٦٧ب: «غيرُ مقيسة».)
#
# # ولماذا قصاصةٌ لا ثلاثُ نسخ
#
# **وثلاثُ نسخٍ من مُرشِّحِ خصوصيّةٍ تفترق عند أوّل تعديل** — **فيُشدَّد
# بندٌ في نطاقٍ ويُنسى في اثنين، ولا أحدَ يعلم أيُّها الحقّ.** **والعقدُ
# واحدٌ فيُكتب مرّةً.**
#
# # والرمزُ لا يُكتب
#
# **قناةُ البثّ تُنادى `/api/v1/ws?token=eyJ…`** (`server/ws.go`)،
# **وCaddy تسجّل `uri` كاملاً بالاستعلام.** **فسجلٌّ بلا مُرشِّحٍ يكتب
# رمزَ وصولٍ صالحاً في كلّ اتّصال.** وقِيس في التجهيز: ظهر حرفيّاً بلا
# المُرشِّح، واختفى به.
#
# # والتوقيعُ مِفتاحٌ حاملٌ لا معرِّف
#
# **والوسيطُ الخاصُّ يُخدَم برابطٍ موقَّع**:
# `/media/2026/09/<uuid>.jpg?exp=…&sig=<HMAC>` (`media/access.go`).
# **و`sig` يكفي وحدَه لجلب الملفّ حتّى ينتهي أجلُه** — **فمن قرأ
# السجلَّ فتح صورةَ إنسان.** **و`exp` يبقى**: ختمُ وقتٍ لا يفتح شيئاً.
#
# # والترويساتُ تُحذف جملةً
#
# **وCaddy تُخفي `Authorization` و`Cookie` من نفسها** — **لكنّها
# تُرشِّح بالمنع لا بالسماح**، فلا قائمةَ سماحٍ للترويسات. **ومن أراد
# ألّا يُسرّب ما لم يخطر له حذف الخريطة كلَّها.**
#
# # ولا هويّةَ دائمةً في سجلّ وصول
#
# **و`user_id` فارغٌ اليومَ لأنّ البوّابةَ لا تُوثّق أحداً** — **لكنّ
# فارغاً اليومَ يُملأ غداً بلا انتباه، وسجلُّ وصولٍ يحمل هويّةَ زبونٍ
# دائمةً يصير سجلَّ تتبّع.** فيُحذف من العقد لا من القيمة.
#
# # وحارسٌ نمطيٌّ على المسار لا يُضاف
#
# **ومُرشِّحان على `request>uri` لا يجتمعان — آخرُهما يغلب.** وقِيس:
# أُضيف `regexp` فمحا الأرقامَ **وأسقط مُرشِّحَ الاستعلام معه فتسرّب
# الرمز.** **والاستعلامُ أولى**: هو الذي يحمل سرّاً تُصدره المنصّةُ
# بنفسها. (وقد دُقّقت مساراتُ المنتج: `{id}` كلُّها `uuid`، ولا هاتفَ
# ولا رمزَ في مقطعِ مسارٍ بالتصميم.)
(rahalgo_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete sig
					replace lat REDACTED
					replace lng REDACTED
					replace q REDACTED
					replace bbox REDACTED
					replace ref REDACTED
					replace path REDACTED
				}
				request>headers delete
				resp_headers delete
				user_id delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 32
				}
			}
		}
	}

	# **وزمنُ المنبع غيرُ زمن البوّابة** — **و`duration` يجمعهما**، فمن
	# رآه وحدَه لا يعرف أفي المحرّك بطءٌ أم في الطريق. **وحالةُ المنبع
	# لا عنصرَ نائبَ لها** في Caddy، فلا تُلتقَط. **وفي نطاق الخرائط
	# لا منبعَ أصلاً** (ملفّاتٌ ساكنة) — فتأتي فارغةً، وهذا صوابُها.
	log_append upstream_duration {http.reverse_proxy.upstream.duration_ms}
}

# ── الويب ─────────────────────────────────────────────────────────────
rahalgo.com, www.rahalgo.com {
	import rahalgo_log

	encode zstd gzip

	# ══════════════════════════════════════════════════════════════════
	# **ورابطُ الدعوة يُخدَم من هنا لا من تطبيق الويب**
	# ══════════════════════════════════════════════════════════════════
	#
	# (قرارُ المالك ٢٠٢٦-٠٨-١٨: «نسخُ الويب لا تعدّل عليه أيَّ شيء،
	#  لأنّني سوف ألغي دخولَ الزبون من الويب — يبقى فقط من التطبيق».)
	#
	# **وكان `rahalgo.com/signup` يردّ صفحةَ «غير موجودة»** — قِيس
	# ٢٠٢٦-٠٨-١٨. **ودعوةٌ تقود إلى ٤٠٤ دعوةٌ ضائعة.**
	#
	# **فيُخدَم ملفٌّ ساكنٌ من البوّابة** — ولا يُمسّ `web/apps/rahalgo`.
	handle /signup* {
		root * /srv/invite
		try_files /index.html
		file_server
	}

	# ══════════════════════════════════════════════════════════════════
	# **وصفحتا الخصوصيّة وحذف الحساب — شرطا غوغل بلاي**
	# ══════════════════════════════════════════════════════════════════
	#
	# (تدقيقُ الجاهزيّة ٢٠٢٦-٠٨-١٩: بلاي يرفض آليّاً بلا رابطِ سياسةِ
	#  خصوصيّةٍ يعمل، ويطلب طريقاً لحذف الحساب من خارج التطبيق.)
	#
	# **وملفّان ساكنان من البوّابة** — قرارُ المالك: لا يُعدَّل تطبيقُ
	# الويب.
	handle /privacy* {
		root * /srv/legal
		rewrite * /privacy.html
		file_server
	}
	handle /delete-account* {
		root * /srv/legal
		rewrite * /delete-account.html
		file_server
	}

	# **وملفُّ الربط يجعل الرابطَ يفتح التطبيقَ بلا سؤال** — بلاه يسأل
	# أندرويد «بأيّ تطبيقٍ تفتح؟» أو يفتح المتصفّح، **فيرى المدعوُّ
	# صفحةَ تنزيلٍ وهو مثبِّتٌ للتطبيق أصلا.**
	#
	# **والنوعُ يجب أن يكون JSON** — أندرويد يرفضه نصّاً عاديّا.
	handle /.well-known/assetlinks.json {
		root * /srv/wellknown
		# **والمسارُ يُعاد كتابتُه إلى اسم الملفّ** — `file_server` تبحث
		# عن `/srv/wellknown/.well-known/assetlinks.json`، **فتردّ ٤٠٤**
		# وقد قِيس ٢٠٢٦-٠٨-١٨.
		rewrite * /assetlinks.json
		header Content-Type application/json
		file_server
	}

	reverse_proxy web:3000
}

# ── المحرّك ───────────────────────────────────────────────────────────
#
# **والوسائطُ تمرّ من هنا أيضاً** (`/uploads/*`) — يخدمها المحرّكُ نفسُه
# من قرصه.
api.rahalgo.com {
	import rahalgo_log

	encode zstd gzip

	# **ورفعُ صورةٍ قد يطول** — والافتراضيُّ دقيقتان يقطعان رفعَ صورةِ
	# تسليمٍ على شبكةٍ ضعيفة.
	reverse_proxy api:8080 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

# ── الخرائط ───────────────────────────────────────────────────────────
#
# ══════════════════════════════════════════════════════════════════════
#  **البابُ الذي لم يُفتح — والخرائطُ جاهزةٌ على القرص منذ آذار**
# ══════════════════════════════════════════════════════════════════════
#
# (بلاغُ المالك ٢٠٢٦-٠٨-٣٠: «مشكلة عامّة بالخرائط بالتطبيقات والويب».)
#
# **و`maps.rahalgo.com` يشير إلى هذا الخادم منذ البداية** — والآثارُ
# مبنيّةٌ كاملةً: خمسمئةُ ميغا `syria.pmtiles` ومناطقُ وموارد ونمط.
#
# **ولا موقعَ بهذا الاسم في هذا الملفّ** — فيقع كلُّ طلبٍ على الافتراضيّ
# **فيردّ أربعمئةً وأربعة.** والتطبيقُ يقرؤها «تعذّر تحميل الخريطة»،
# **والويبُ يسقط إلى بلاطات OpenStreetMap العامّة** التي تحجب من يُكثر.
#
# **وعطبٌ في إعدادٍ لا في شيفرة** — فلا يمسكه بناءٌ ولا اختبارُ وحدة،
# **ولا يظهر إلّا حين ينظر أحدٌ إلى شاشة.**
#
# # ولماذا مجلّدٌ مرسومٌ لا الجذر
#
# **جذرُ `maps` فيه ١٫٧ غيغا من وسيطٍ وسجلّاتِ بناءٍ ونصوصٍ** — ولا شأن
# لأحدٍ بها. **فتُفتح المجلّداتُ الأربعةُ والفهرسُ وحدَها**، وما عداها
# لا يُخدَم.
maps.rahalgo.com {
	import rahalgo_log

	encode zstd gzip

	root * /srv/maps

	# **والويبُ يقرؤها من أصلٍ آخر** — بلا هذه لا تُحمَّل بلاطةٌ في
	# متصفّح، **والتطبيقُ لا يعنيه لأنّه ليس متصفّحاً.**
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Range, If-None-Match"
		Access-Control-Expose-Headers "Content-Length, Content-Range, ETag, Accept-Ranges"
	}

	# ══════════════════════════════════════════════════════════════════
	# **والفهرسُ وحدَه لا يُخزَّن**
	# ══════════════════════════════════════════════════════════════════
	#
	# **آثارُ الخرائط في مساراتٍ مؤرَّخة** (`base/2026-08-24/…`) — فما
	# نُزّل مرّةً صالحٌ أبداً، **وسنةٌ كاملةٌ لا تضرّ.**
	#
	# **والفهرسُ هو ما يتبدّل** — ومن خزّنه يوماً لم يرَ خريطةً جديدةً
	# نُشرت. **فدقيقةٌ واحدة.**
	@manifest path /manifest.json
	header @manifest Cache-Control "public, max-age=60"

	@artifacts path /base/* /regions/* /map-resources/* /style/* /sprite/*
	header @artifacts Cache-Control "public, max-age=31536000, immutable"

	# **ولا يُخدَم إلّا ما رُسم** — `work` و`scripts` والسجلّاتُ خارج.
	@allowed path /manifest.json /base/* /regions/* /map-resources/* /style/* /sprite/*
	handle @allowed {
		file_server {
			precompressed br gzip
		}
	}

	# **وما عداه أربعمئةٌ وأربعة صريحة** — لا سردَ مجلّدٍ ولا تخمين.
	handle {
		respond 404
	}
}
