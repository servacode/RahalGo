<!--
  **درّاجةُ التوصيل — بصندوقها على ظهرها.**

  (قرارُ المالك ٢٠٢٦-٠٨-١٥: «غيّر أيقونة الموتور لأيقونةٍ أحلى واضحة».)

  **ورسمُ Material كان دقيقاً كثيراً**: عجلتان وهيكلٌ وخطوطٌ رفيعةٌ
  **تتلاشى عند أربعٍ وعشرين نقطة** فتُقرأ لطخةً لا مركبة.

  **وهذه أشكالٌ غليظةٌ قليلة**: عجلتان مفرَّغتان · لوحٌ · عمودٌ مائلٌ ·
  مقودٌ · وصندوقُ التوصيل. **وما يُعرف من ظلّه يُعرف في أيّ مقاس.**

  **وهي متّجهةٌ يميناً** — وتُقلب أفقيّاً في الشريط لتسير حيث تنظر.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- **العجلتان مفرَّغتان** — دائرةٌ مصمتةٌ تُقرأ كرةً لا عجلة. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5.8,13.9 a3.3,3.3 0 1,0 0.01,0 Z M5.8,15.7 a1.5,1.5 0 1,1 -0.01,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M18.2,13.9 a3.3,3.3 0 1,0 0.01,0 Z M18.2,15.7 a1.5,1.5 0 1,1 -0.01,0 Z" />

    <!-- **صندوقُ التوصيل** — هو ما يفرّق درّاجةَ توصيلٍ عن درّاجة. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3.2,5.4 h5.2 a1.3,1.3 0 0 1 1.3,1.3 v5.8 a1.3,1.3 0 0 1 -1.3,1.3 h-5.2 a1.3,1.3 0 0 1 -1.3,-1.3 v-5.8 a1.3,1.3 0 0 1 1.3,-1.3 Z" />

    <!-- **اللوحُ يصل العجلتين** — ولولاه شكلان متفرّقان. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.5,12.6 h9 a0.8,0.8 0 0 1 0,1.6 h-9 a0.8,0.8 0 0 1 0,-1.6 Z" />

    <!-- **العمودُ المائلُ والمقود.** -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15.0,13.9 L16.3,13.5 L18.4,7.6 L17.1,7.2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M16.0,6.0 h4.0 a0.8,0.8 0 0 1 0,1.6 h-4.0 a0.8,0.8 0 0 1 0,-1.6 Z" />
</vector>
