<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
  **لا نسخةَ احتياطيّةً لبيانات التطبيق**
  ══════════════════════════════════════════════════════════════════════

  (تدقيقُ الإطلاق ٢٠٢٦-٠٨-١٩ — BUG-003.)

  **والتوكنُ مشفَّرٌ بمفتاحٍ في `Keystore` الجهاز** — **والمفتاحُ لا
  يُنقل.** فملفٌّ مستعادٌ على جهازٍ آخرَ لا يُفكّ، **وبناءُ
  `EncryptedSharedPreferences` عليه يرمي** — والتطبيقُ ينهار عند
  الإقلاع بلا رسالةٍ تقول لماذا.

  **ولا خسارةَ في المنع**: ما يُحفظ محلّيّاً هو التوكنُ والسلّةُ
  والسمة. **والتوكنُ لا يُنقل أصلا، والسلّةُ تُبنى في دقيقة.**

  # ونقلُ الجهاز يُمنع كذلك

  **`deviceTransfer` هو ما يقع في «نقل من هاتفٍ قديم»** — وهو أشيعُ من
  الاستعادة السحابيّة اليوم، **وفيه العطبُ نفسُه.**
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
