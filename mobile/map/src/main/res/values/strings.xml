<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════
     **نصوصُ منتقي النقطة**
     ══════════════════════════════════════════════════════════════

     **وتقول ما يُفعل لا ما هو** — «حرّك الخريطة» تُعلّم بلا شرح،
     **و«اختر موقعاً» تصف ولا تُعلّم.** -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="pick_search">ابحث عن منطقة أو شارع…</string>
    <!-- **وفوق الدبّوس لا تحت الشاشة** — (صورُ المالك ٢٠٢٦-٠٨-١٨):
         **التلميحُ عند ما يُفعل به**، ومن قرأ سطراً في الأسفل لا يربطه
         بالدبّوس في الوسط. -->
    <string name="pick_drag">اسحب لتحديد الموقع</string>
    <string name="pick_reading">جاري تحديد الموقع…</string>
    <string name="pick_confirm">تأكيد الموقع</string>
    <string name="pick_cancel">إلغاء</string>
    <!-- **أيقونةُ «موقعي»** — (طلبُ المالك ٢٠٢٦-٠٨-١٨: «كما تعرف بغوغل
         ماب يوجد أيقونةُ موقعي أو تحديد الموقع بدقّة يجب أن تكون
         موجودة، يضغط عليها يتم تحديد عنوانه ثم زرّ حفظ»). -->
    <string name="pick_my_location">موقعي الحالي</string>
    <string name="pick_no_location">تعذر تحديد موقعك — فعل الموقع وحاول ثانية</string>
    <!-- **حين لا يُبنى النمط** — إغلاقُ TD-CUSTOMER-MAP-NO-MANIFEST.
         والسببُ شبكةٌ في الغالب، والبياضُ يُقرأ عطباً في التطبيق. -->
    <string name="map_unreachable">تعذّر تحميل الخريطة — تحقّق من الاتّصال وحاول مرّة أخرى</string>
    <!-- **فشلُ البحث لا نتيجتُه الفارغة** — 503/انقطاعٌ على `/geo/search`
         كان يُبتلع صامتاً فيُقرأ «لا نتائج»؛ فيُصرَّح به ويُتاح تكرارُه،
         والمسارُ اليدويُّ (سحبُ الدبّوس) باقٍ. (CUST-07-006) -->
    <string name="pick_search_failed">تعذّر البحث — تحقّق من الاتّصال وحاول مرّة أخرى، أو حرّك الخريطة لتحديد الموقع</string>
    <string name="pick_search_retry">إعادة المحاولة</string>
    <!-- وصفُ الخريطة لقارئ الشاشة — يطغى على نصّ MapLibre الإنكليزيّ
         («Showing a Map created with MapLibre…»)، رُئي على الجهاز في الخطوة ١٥. -->
    <string name="maplibre_mapActionDescription" tools:ignore="UnusedResources">خريطة — اسحبها لتحريكها، وباعد إصبعيك للتقريب</string>
    <!-- دقّة الموقع (٢٠٢٦-١٠-١٢) -->
    <string name="pick_acc_waiting">عم نحدّد موقعك…</string>
    <string name="pick_acc_value">دقة الموقع: ± %1$d م</string>
    <string name="pick_acc_improving">عم نحسّن…</string>
    <string name="pick_acc_outside">إذا كنت داخل البيت أو المحل، الأفضل تطلع لبرّا أو تقرّب من الشبّاك ليتحدد موقعك بدقة أكبر.</string>
    <string name="pick_wait_accuracy">زر التأكيد بيطلع لمّا تصير الدقة ١٥ متر أو أقل — أو حرّك الدبوس بإيدك لمكانك</string>
    <string name="pick_choose_first">اضغط «موقعي» أو حرّك الدبوس بإيدك لمكانك الصحيح</string>
</resources>
