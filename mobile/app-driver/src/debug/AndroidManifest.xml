<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   بيانُ التصحيح — يضيف إعدادَ أمنِ الشبكة ولا شيء غيرَه
  ══════════════════════════════════════════════════════════════════════

  (قرارُ المالك ٢٠٢٦-٠٨-٢٢، بند ٥.)

  ولا إذنَ جديدٌ هنا ولا مكوّنٌ جديد — سمةٌ واحدةٌ على `application`.
  ومن أضاف أكثرَ من ذلك أضافه إلى الإصدار من حيث لا يدري: البياناتُ
  تُدمَج، والمجموعةُ التجريبيّةُ وحدَها هي التي لا تُدمَج في الإصدار.

  و`tools:replace` غيرُ لازمٍ لأنّ البيانَ الأصليَّ لا يذكر السمة أصلاً
  — فلا تعارضَ يُحَلّ.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ══════════════════════════════════════════════════════════════
             مختبرُ الرحلة التجريبيّة — بناءُ التطوير وحدَه
             ══════════════════════════════════════════════════════════════
             معلَنٌ في بيان التطوير فقط، فلا وجودَ له في الإصدار البتّة.
             يُطلَق بفعلٍ صريحٍ محروسٍ بـ BuildConfig.DEBUG من الشاشة. -->
        <!-- exported=true مقصورٌ على بناء التطوير (هذا البيانُ في src/debug
             وحدَه) — يتيح لـ adb تشغيلَ المختبر لقياس QA. **لا وجودَ له في
             الإصدار البتّة** فلا سطحَ تصديرٍ في الإنتاج. -->
        <activity
            android:name="com.rahalgo.driver.replaylab.ReplayLabActivity"
            android:exported="true"
            android:label="مختبر الملاحة (تشخيص)">
            <intent-filter>
                <action android:name="com.rahalgo.driver.debug.REPLAY_LAB" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- الرحلة التجريبيّة المواجِهةُ للمالك — على شاشة الرحلة الحقيقيّة.
             بناءُ التطوير وحدَه؛ exported=true مقصورٌ على التطوير (adb/QA). -->
        <activity
            android:name="com.rahalgo.driver.replaylab.ReplayTripActivity"
            android:exported="true"
            android:label="رحلة تجريبيّة">
            <intent-filter>
                <action android:name="com.rahalgo.driver.debug.REPLAY_TRIP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
