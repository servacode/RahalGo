<?xml version="1.0" encoding="utf-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════
   بيانُ التصحيح — يضيف إعدادَ أمنِ الشبكة ولا شيء غيرَه
  ══════════════════════════════════════════════════════════════════════

  (قرارُ المالك ٢٠٢٦-٠٨-٢٢، بند ٥.)

  ولا إذنَ جديدٌ هنا ولا مكوّنٌ جديد — سمةٌ واحدةٌ على `application`.
  ومن أضاف أكثرَ من ذلك أضافه إلى الإصدار من حيث لا يدري: البياناتُ
  تُدمَج، والمجموعةُ التجريبيّةُ وحدَها هي التي لا تُدمَج في الإصدار.

  و`tools:replace` غيرُ لازمٍ لأنّ البيانَ الأصليَّ لا يذكر السمة أصلاً
  — فلا تعارضَ يُحَلّ.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
