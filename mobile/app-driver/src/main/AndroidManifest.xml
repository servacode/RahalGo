<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- **الإنترنت** — التطبيق يكلّم المحرّك في كل شاشة.
         **وبلا هذا السطر يسقط كل نداء برفض أمنيّ** لا برسالة شبكة،
         فيبحث القارئ في العنوان والخادم والعلّة في ملفّ البيان. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ══════════════════════════════════════════════════════════════
         **الموقع — عمود التطبيق**
         ══════════════════════════════════════════════════════════════

         **بلا موقع لا مسافة على البطاقة**، ولا توزيع «الأقرب» على
         حقيقته، ولا يرى الزبون سائقه يتحرّك.

         **والخلفيّة تُطلب وحدها بعد الأماميّة** (شرط أندرويد ١١+):
         من طلبهما معا رُفض طلبه كلّه.

         **والخدمة الأماميّة نوعها `location` مصرَّح** — بلا التصريح
         يرفض النظام تشغيلها من أندرويد ١٤.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- **وإشعار الخدمة يحتاج إذنا من أندرويد ١٣** — وبلاه تعمل الخدمة
         بلا أن يراها صاحبها، وهو ما يمنعه النظام. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- **الكاميرا — لإثبات التسليم وحدَه.** ويُطلب إذنُها عند أوّل
         تسليمٍ لا عند الدخول: **إذنٌ يُطلب بلا سببٍ ظاهرٍ يُرفض.** -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".DriverApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/rahalgo_no_backup"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RahalGo.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- **خدمة أماميّة نوعها موقع** — تعمل ما دامت الوردية مفتوحة.
             **وخدمة عاديّة يقتلها النظام** بعد دقائق من إطفاء الشاشة. -->
        <!-- **مستقبل الإشعارات** — يعمل والتطبيق مغلق، وهو ما يجعل
             الطلب يصل السائق بلا أن ينظر إلى شاشته. -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
