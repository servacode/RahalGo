# انسخ هذا الملف إلى .env وعدّل القيم — ممنوع وضع أسرار حقيقية في Git
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://rahalgo:rahalgo_dev@localhost:5432/rahalgo?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# المصادقة
JWT_SECRET=dev-secret-change-me
# dev = يطبع رمز OTP في السجل | whatsapp = عبر البوت (يُفعَّل مع تكامل whatsmeow)
OTP_PROVIDER=dev
# هاتف أول أدمن — يُنشأ/يُمنح دور admin تلقائياً عند الإقلاع
ADMIN_PHONE=

# ── بوّابة الرسائل النصّية — إبلاغُ المتاجر بطلباتها ──────────────────────
#
# تُترك فارغةً فيُعطَّل الإرسال ويُردّ بخطأٍ صريح (لا ابتلاعَ صامت).
#
# ولماذا رسالةٌ نصّية لا بوت واتساب: البوت غيرُ رسميّ، يحتاج اقتراناً بهاتف
# وينقطع، ويُحظَر حسابُه إن أكثر من الإرسال الآليّ — وحظرُه يُوقف رموزَ التحقّق
# معه فيُعطَّل الدخول كلُّه لأجل إبلاغِ مطعم.
#
# قالبٌ عامّ يقبل أيَّ مزوّد: {phone} و{text} و{sender} تُستبدل عند الإرسال.
# ومزوّدو سوريا يتغيّرون — فتبديلُ المزوّد تبديلُ متغيّرات لا تعديلُ شيفرة.
#
# مثال (مزوّد JSON):
#   SMS_URL=https://api.provider.sy/v1/send
#   SMS_BODY={"to":"{phone}","text":"{text}","from":"{sender}"}
#   SMS_AUTH_HEADER=Authorization: Bearer YOUR_KEY
#
# مثال (مزوّد GET بسلسلة استعلام):
#   SMS_URL=https://sms.provider.sy/send?to={phone}&msg={text}&key=YOUR_KEY
#   SMS_METHOD=GET
SMS_URL=
SMS_METHOD=POST
SMS_BODY=
SMS_CONTENT_TYPE=application/json
SMS_AUTH_HEADER=
SMS_SENDER=RahalGo
