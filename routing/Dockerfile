# ══════════════════════════════════════════════════════════════════════
#  محرّك المسارات — OSRM على خريطة سوريا
# ══════════════════════════════════════════════════════════════════════
#
# (قرار المالك ٢٠٢٦-٠٨-١٢: «الخريطة لا تحترم الشوارع، ترسم خطّاً مستقيماً
#  من فوق البيوت — وهذا رح يسبّب حسابات وقت ومسافة خاطئة».)
#
# # لماذا OSRM لا Valhalla ولا GraphHopper
#
# **قوّةُ الآخرَين فيما لا نحتاجه**: Valhalla تجمع مشياً وباصاً وسيّارةً في
# مسار واحد، وGraphHopper تعطي كلَّ طلبٍ أوزانَه (شاحنةٌ تتجنّب جسراً).
# **ونحن موتورٌ واحدٌ في مدينةٍ واحدة** — وضعفُ OSRM الوحيد (تبديلُ نمط
# السير يحتاج إعادةَ بناء) لا يمسّنا: **نمطٌ واحدٌ لا يتبدّل.**
#
# **وأوبر نفسُها كانت عليه** حتّى ٢٠١٥، ثمّ بنت محرّكها — **لا لضعفٍ فيه،
# بل لأنّها بلغت مئتين وخمسين مليون استعلامٍ في اليوم.**
#
# # ولماذا على خادمنا لا واجهةٌ مدفوعة
#
# **نسأل عن المسار مع كلّ نبضة موقع** — وهو بالضبط التردّد الذي تُحاسِب
# عليه Mapbox وغوغل. **وهنا صفرُ كلفةٍ لكلّ نداء**، ولا مفتاحَ ولا بطاقةَ
# ولا طرفٌ ثالثٌ يقطع.
#
# # والبناء يقع مرّةً في الصورة لا عند الإقلاع
#
# **الاستخراجُ والتقسيمُ عملٌ ثقيلٌ يقع مرّة** — فيُخبز في الصورة. **ومن
# تركه للإقلاع** جعل كلَّ إعادةِ تشغيلٍ تنتظر دقائق.
#
# **وسوريا ملفٌّ صغير** (~٥٠ ميغا) — بخلاف أوروبا التي تحتاج عشرات
# الغيغابايتات من الذاكرة.
# ══════════════════════════════════════════════════════════════════════
# **النسخةُ مثبَّتةٌ ببصمتها — المرحلة ٧، قرارُ المالك ٢٠٢٦-٠٨-٢١**
# ══════════════════════════════════════════════════════════════════════
#
# **أمرُ المالك نصّاً**: «لا يمكن بناء Thresholds واختبارات على نسخة ثم
# السماح للبناء بأن يتغير تلقائيًا».
#
# **وكلُّ قياسات المرحلة ٧ جرت على `v26.8.0`**: عتباتُ التشابه،
# وسياسةُ الترشيح، وحجمُ الحمولة، **وحقيقةُ أنّ `weight_name` هو
# `routability` لا `duration`.**
#
# **و`:latest` كانت تعني «ما يصدر غداً»** — فبناءٌ في الأسبوع القادم
# قد يأتي بمحرّكٍ يرتّب البدائلَ بطريقةٍ أخرى، **فتصير اختباراتُنا
# تصف ماضياً.**
#
# **والبصمةُ فوق الوسم** — فالوسمُ يُعاد تعيينُه في المنبع والبصمةُ لا.
FROM ghcr.io/project-osrm/osrm-backend:v26.8.0-amd64-debian@sha256:9369eafc08bb43d4b2ba4ba5a3917af280d8cb5fc7515d3569de007e749c3697

WORKDIR /data

# **وبلاطاتُ الخريطة وبياناتُ المسار من مصدرٍ واحد** — OpenStreetMap.
# **فالخطُّ يمشي في الشارع الذي يراه السائق مرسوماً تحته**، لا في شارعٍ
# يعرفه مزوّدٌ آخر.
ARG PBF_URL=https://download.geofabrik.de/asia/syria-latest.osm.pbf

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o syria.osm.pbf "${PBF_URL}" \
 # **ونمطُ السيّارة للموتور**: يمشي في الشوارع نفسِها ويُمنع مما تُمنع
 # منه. **وفارقُ السرعة يُضبط لاحقاً** بملفّ نمطٍ خاصّ إن لزم.
 && osrm-extract -p /opt/car.lua syria.osm.pbf \
 && osrm-partition syria.osrm \
 && osrm-customize syria.osrm \
 # **والملفُّ الخامُ يُحذف** — لا يُقرأ بعد الاستخراج، ويضاعف حجم الصورة.
 && rm -f syria.osm.pbf

# **والمنفذُ من البيئة** — Render يعطيه، **والثابتُ يجعل الخدمةَ تُقرأ
# ميّتةً وهي تعمل.**
CMD ["sh", "-c", "osrm-routed --algorithm mld --ip 0.0.0.0 --port ${PORT:-5000} /data/syria.osrm"]
