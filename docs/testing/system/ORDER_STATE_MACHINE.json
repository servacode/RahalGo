 "mode_rules_declared": [
  {
   "id": "P1",
   "what": "وضعُ المنصّة يُسقط دورَ المتجر دائماً",
   "source": "internal/orders/modes.go:131"
  },
  {
   "id": "P2",
   "what": "الدخولُ إلى preparing يُسقط ops وadmin",
   "source": "internal/orders/modes.go:144"
  },
  {
   "id": "P3",
   "what": "وجهةٌ في driverOnly تُسقط ops وadmin",
   "source": "internal/orders/modes.go:171"
  },
  {
   "id": "P4",
   "what": "**مُبتَلَعةٌ في P3** — شرطُها جزءٌ من شرطِها فلا تُسقط شيئاً جديداً",
   "source": "internal/orders/modes.go:208"
  },
  {
   "id": "P5",
   "what": "الإلغاءُ بعد التسليم للسائق يُسقط ops لغير المالك",
   "source": "internal/orders/modes.go:224"
  },
  {
   "id": "M0",
   "what": "وضعُ المتاجر لا يُنقّي شيئاً — يردّ الأدوارَ كما هي",
   "source": "internal/orders/modes.go:123"
  },
  {
   "id": "A0",
   "what": "المالكُ يملك كلَّ حدٍّ في الخريطة ولا يخترع حدّاً",
   "source": "internal/orders/statuses.go:330"
  },
  {
   "id": "D0",
   "what": "**driverHolds يُمرَّر ولا يُقرأ** — فالجدولُ دالّةُ (kind, from, to, roles, mode) وحدَها",
   "source": "internal/orders/modes.go:61"
  }
 ],
 "guards_declared": [
  {
   "id": "G0",
   "what": "قفلُ الصفِّ FOR UPDATE قبل أيّ قراءة",
   "source": "internal/orders/transitions.go:70"
  },
  {
   "id": "G1",
   "what": "الوضعُ يُقرأ من داخل المعاملة لا قبلها",
   "source": "internal/orders/transitions.go:106"
  },
  {
   "id": "G2",
   "what": "canTransition — وإلّا invalid_transition (409)",
   "source": "internal/orders/transitions.go:109"
  },
  {
   "id": "G3",
   "what": "at_pickup وpicked_up يشترطان سائقاً مُسنَداً — driver_required (409)",
   "source": "internal/orders/transitions.go:115"
  },
  {
   "id": "G4",
   "what": "المخصَّصُ إلى picked_up يشترط custom_agreed_at",
   "source": "internal/orders/transitions.go:128"
  },
  {
   "id": "G5",
   "what": "ويشترط قفلَ السعر quote_confirmed_version == quote_version",
   "source": "internal/orders/transitions.go:141"
  },
  {
   "id": "G6",
   "what": "at_pickup → failed **يُحوَّل** إلى merchantBlocked ولا يُنفَّذ",
   "source": "internal/orders/transitions.go:168"
  },
  {
   "id": "G7",
   "what": "نافذةُ إلغاء الزبون — وتُقاس على الأدوار الخامّ فيتجاوزها زبونٌ يحمل ops",
   "source": "internal/orders/transitions.go:301"
  },
  {
   "id": "H1",
   "what": "الأدمن يحتاج القدرة orders.intervene",
   "source": "internal/server/server.go:1176"
  },
  {
   "id": "H2",
   "what": "السائقُ إلى delivered يحتاج إثباتاً إن فُعّل drivers.require_delivery_photo",
   "source": "internal/server/delivery_proof.go:189"
  },
  {
   "id": "H3",
   "what": "قبولُ العرض يشترط ورديّةً مفتوحةً وسقفَ نقدٍ وسقفَ طلبات",
   "source": "internal/server/driver_handlers.go:614"
  }
 ],
 "auto_rules_declared": [
  {
   "id": "AUTO-PREPARING",
   "what": "accepted → preparing — **وضعُ المتاجر وحدَه**، بأدوار الفاعل الأصليّ",
   "source": "internal/orders/transitions.go:552"
  },
  {
   "id": "AUTO-DISPATCH",
   "what": "preparing → dispatching — وضعُ المتاجر وorders.auto_dispatch، بأدوار ops قسراً",
   "source": "internal/orders/transitions.go:559"
  },
  {
   "id": "AUTO-DISPATCH-EXPORTED",
   "what": "AutoDispatch بلا شرطِ وضعٍ ولا علَم — **وهو طريقُ وضع المنصّة**",
   "source": "internal/orders/transitions.go:568"
  },
  {
   "id": "AUTO-ACCEPT",
   "what": "pending → accepted بعد orders.auto_accept_min (افتراضُه صفرٌ ⇒ مطفأ)",
   "source": "internal/orders/watchdog.go:257"
  },
  {
   "id": "AUTO-TRANSFER",
   "what": "pending → accepted ثمّ إنزال — orders.auto_transfer (افتراضُه لا)",
   "source": "internal/server/auto_transfer.go:98"
  },
  {
   "id": "AUTO-ASSIGN",
   "what": "dispatching → assigned بالدور",
   "source": "internal/orders/rotation.go:541"
  }
 ],
 "implicit_edges_declared": [
  {
   "id": "IMPLICIT-AT-PICKUP-ACCEPTED",
   "what": "at_pickup → accepted — **لا تظهر في خريطةٍ ولا في TRUTH.md**: merchantBlocked يردّ الطلبَ مقبولاً ويُفرّغ السائقَ ويُثبّت الذنبَ على المتجر",
   "source": "internal/orders/merchant_blocked.go:46"
  }
 ],
