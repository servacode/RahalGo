    {
      "id": "EV-09",
      "flows": [
        "F-18"
      ],
      "title": "تحويلٌ تلقائيٌّ يُعلَم به المتجر",
      "entity": "order",
      "entity_id_required": true,
      "deep_link_contract": "/orders/{id}",
      "must_receive": [
