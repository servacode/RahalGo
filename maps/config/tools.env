# ══════════════════════════════════════════════════════════════════════
# **أدواتُ البناء — بإصداراتٍ مثبَّتةٍ لا «الأحدث»**
# ══════════════════════════════════════════════════════════════════════
#
# (المرحلة ٦أ، إغلاقُ أدوات الموارد، قرارُ المالك ٢٠٢٦-٠٨-٢١، البند ٣:
#  «لا أريد developer manually installed latest version».)
#
# # ولماذا التثبيت
#
# **أداةٌ تتبدّل تحتنا تُنتج حروفاً مختلفةً بلا أن نغيّر سطراً** —
# فيتبدّل شكلُ الخريطة، **ولا شيءَ في السجلّ يقول لماذا.**
#
# **والبصمةُ تُقرأ عند التنزيل** — فلو بُدّل ملفٌّ في المنبع عُرف.

# ══════════════════════════════════════════════════════════════════════
# **١ · حروفُ الخطّ**
# ══════════════════════════════════════════════════════════════════════
#
#   الأداة    build_pbf_glyphs
#   المصدر    crates.io  (Rust)
#   التثبيت   cargo install --version <محدَّد> --root <مجلّد الأدوات>
#
# **و`cargo` يثبّت بالنسخة فيُعيد البناءَ نفسَه** — والقفلُ في رقم
# النسخة لا في بصمةِ ثنائيّ، **لأنّ الثنائيَّ يُبنى محلّيّاً.**
GLYPH_TOOL=build_pbf_glyphs
GLYPH_TOOL_VERSION=1.5.1
GLYPH_TOOL_SOURCE=crates.io

# ══════════════════════════════════════════════════════════════════════
# **٢ · الأيقونات**
# ══════════════════════════════════════════════════════════════════════
#
#   الأداة    spreet
#   المصدر    إصدارُ GitHub — ثنائيٌّ جاهز
#   البصمة    تُتحقَّق عند التنزيل
SPRITE_TOOL=spreet
SPRITE_TOOL_VERSION=0.13.1
SPRITE_TOOL_SOURCE=https://github.com/flother/spreet/releases/download/v0.13.1
# **بصمةُ نسخة ويندوز — قِيست ٢٠٢٦-٠٨-٢١.**
SPRITE_TOOL_SHA256_WINDOWS=a9cd066f39b4738863757fbc48a6b5984ed731258c3858d5323bae5239e14d2a

# ══════════════════════════════════════════════════════════════════════
# **٣ · الخطّ**
# ══════════════════════════════════════════════════════════════════════
#
# **ولا ملفَّ خطٍّ في المستودع** (البند ٦) — يُنزَّل عند البناء
# **وتُتحقَّق بصمتُه**، ويُحفظ ترخيصُه بجانب الحروف.
#
# **وNoto Naskh Arabic بترخيص OFL 1.1** — يبيح التضمينَ والتوزيعَ
# دونَ اتّصالٍ صراحةً. **و«تجوال» لم يُقرأ ترخيصُه** فلا يُبنى عليه.
FONT_FAMILY="Noto Naskh Arabic"
FONT_VERSION=v2.020
FONT_LICENSE="OFL-1.1"
FONT_LICENSE_URL=https://github.com/notofonts/naskh-arabic/blob/main/OFL.txt
