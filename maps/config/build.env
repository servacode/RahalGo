# ══════════════════════════════════════════════════════════════════════
# **وصفةُ بناء الخرائط — رقمٌ واحدٌ لكلّ قرار**
# ══════════════════════════════════════════════════════════════════════
#
# (المرحلة ٦أ، بقرار المالك ٢٠٢٦-٠٨-٢١.)
#
# **وكلُّ ما يقرّره القياسُ هنا، ولا رقمَ في سكربت.**
#
# # والقياسُ الذي حسم هذه الأرقام
#
#   syria z14  =  110.0 م.ب ·  58,856 بلاطة  ·  يُسقط ٦٠٪ من طرق الرقّة
#   syria z15  =  187.4 م.ب · 196,237 بلاطة
#   syria z16  =  310.3 م.ب · 646,845 بلاطة  ·  وبلاطتُه في حلب ١٨ ك.ب
#                                                مقابل ٢٠٨ عند z14
#
# **فالأدقُّ أخفُّ على الشبكة وأكملُ في التفصيل** — والحجمُ الكلّيُّ
# ثلاثُ مئةِ ميغابايتٍ لا تُذكر. (قرارُ المالك: «ولا نرجع إلى z14».)

# **الاستخراجُ المصدريّ** — اسمُ منطقة Geofabrik.
AREA=syria

# **مدى التقريب** — انظر أعلاه.
BASE_MINZOOM=0
BASE_MAXZOOM=16

# ══════════════════════════════════════════════════════════════════════
# **واللغاتُ اثنتان لا ثمانون**
# ══════════════════════════════════════════════════════════════════════
#
# **ومخطّطُ OpenMapTiles يحمل ثمانين لغةً افتراضاً** — `name:zh-Hant`
# و`name:tok` و`name:ml`… **ولا يقرؤها سائقٌ في الرقّة.**
#
# **وقِيس التوفير** (٢٠٢٦-٠٨-٢١): حزمةُ الرقّة ٢٫٣٤ → ٢٫١٥ ميغابايت،
# **ثمانيةٌ في المئة** — أي نحو خمسةٍ وعشرين ميغابايتٍ على أرشيف سوريا.
LANGUAGES=ar,en

# **ولا نقلَ حرفيّ** — `transliterate` يولّد `name:latin` من العربيّة
# بصورةٍ آليّة، **وهي تسميةٌ لا يقولها أحد.**
TRANSLITERATE=false

# **ذاكرةُ الجافا** — وقِيست ذروةُ الكومة ١٫٠ غيغابايت في أكبر بناء.
JAVA_HEAP=3g

# **ونمطُ خريطة العقد** — يناسب استخراجاً بحجم سوريا.
NODEMAP=sortedtable
STORAGE=mmap

# ══════════════════════════════════════════════════════════════════════
# **الحزمُ الإقليميّة — تُبنى بالحدود لا بالاستخراج**
# ══════════════════════════════════════════════════════════════════════
#
# (قرارُ المالك: «**ممنوع استخدام `pmtiles extract`**… الحزمُ الإقليميّة
#  تُبنى مباشرةً من Planetiler باستخدام bounds».)
#
# **فمسارُ `extract` لا يدخل بنيتَنا أصلاً** — ولا نختبر ما لا نستعمل.
#
#   REGION_<ID>="الاسم|غرب,جنوب,شرق,شمال|أدنى تقريب|أقصى تقريب"
#
# **وحدودُ الرقّة هي حدودُ `OfflineMap` نفسُها** — فما نُنزّله اليومَ
# بالراستر يصير متّجهاً بلا تبديلِ نطاق.
REGION_RAQQA="الرقّة|38.92,35.88,39.12,36.03|10|16"

# **قاعدةُ التقريب في الحزم**: العاشرُ يُري المدينةَ كلَّها، والسادسَ
# عشرَ يُري الأزقّة. **وما دون العاشر يُقرأ من الأرشيف الأساسيّ.**
